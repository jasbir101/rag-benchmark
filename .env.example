# Copy to .env and fill in only what you need. Every variable is optional:
# without them the FAISS and Chroma backends and the offline embedders still work.
# Empty values are treated as "not set". rag-bench reads ./.env on start-up but
# never overrides variables that are already set in your shell.

# --- Gemini embeddings (rag mode, --embedder gemini) ---
GEMINI_API_KEY=
# Embedding model name; change it here if Google renames or retires the model.
GEMINI_EMBED_MODEL=gemini-embedding-001
# Optional output dimensionality (e.g. 768, 1536 or 3072). Empty = model default.
GEMINI_EMBED_DIM=

# --- Milvus (Milvus server or Zilliz Cloud; Milvus Lite does not run on Windows) ---
# e.g. http://localhost:19530 or https://<your-cluster>.zillizcloud.com
MILVUS_URI=
# Token for Zilliz Cloud or an auth-enabled server ("user:password" or an API key).
MILVUS_TOKEN=

# --- Pinecone (serverless) ---
PINECONE_API_KEY=
PINECONE_INDEX=rag-benchmark
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
